text = "被光曬彎的？森林裡的東西，好像都比我記得的更奇怪一點。"

[sub_resource type="Resource" id="L3"]
script = ExtResource("1_line")
speaker = "瑪琳"
text = "……先採草。奇怪的事，回去再跟米拉說。"

