[gd_resource type="Resource" script_class="CutsceneEntry" format=3]

[ext_resource type="Script" path="res://scripts/dialogue/cutscene_line.gd" id="1_line"]
[ext_resource type="Script" path="res://scripts/dialogue/cutscene_entry.gd" id="2_entry"]

[sub_resource type="Resource" id="L1"]
script = ExtResource("1_line")
speaker = ""
text = "熊一掌橫掃，短劍脫手飛出，路德重重摔在濕冷的落葉上，再也爬不起來。"

[sub_resource type="Resource" id="L2"]
script = ExtResource("1_line")
speaker = "路德"
text = "（視線模糊、胸口劇痛，聲音虛弱得快聽不見）……好痛……身體、一點力氣都提不起來……"

[sub_resource type="Resource" id="L3"]
script = ExtResource("1_line")
speaker = "路德"
text = "（恐懼一寸寸爬上來）原來……我真的什麼都做不到……瑪琳、爸媽說的……都是對的……"

[sub_resource type="Resource" id="L4"]
script = ExtResource("1_line")
speaker = "路德"
text = "（眼眶發熱）對不起……我不該逞強、一個人跑進來的……"

[sub_resource type="Resource" id="L5"]
script = ExtResource("1_line")
speaker = ""
text = "（熊的巨影一步步逼近。路德咬緊牙，用盡最後一絲力氣——）"

[sub_resource type="Resource" id="L6"]
script = ExtResource("1_line")
speaker = "路德"
text = "——救、救命——！！！"

[sub_resource type="Resource" id="L7"]
script = ExtResource("1_line")
speaker = ""
text = "（喊聲未落，一道人影懶洋洋踱進空地——下一瞬，寒光一閃，熊悶哼著退開了。）"

[sub_resource type="Resource" id="L8"]
script = ExtResource("1_line")
speaker = "亞倫"
text = "喂喂，這種地方，小鬼跑進來找死啊？"

[sub_resource type="Resource" id="L9"]
script = ExtResource("1_line")
speaker = "路德"
text = "（眼淚還掛在臉上）你是……住旅店那個、成天曬太陽的亞倫大哥……！"

[sub_resource type="Resource" id="L10"]
script = ExtResource("1_line")
speaker = "亞倫"
text = "（把路德一把拉起來）還喊得出聲，看來死不了。走，自己走回去。我還想天黑前補個回籠覺呢。"

[sub_resource type="Resource" id="L11"]
script = ExtResource("1_line")
speaker = "路德"
text = "（盯著那道背影，忘了痛）……好快的劍。那，才是真正的冒險者……"

[resource]
script = ExtResource("2_entry")
id = "s1_bear"
once = "c_s1_bear"
lines = Array[ExtResource("1_line")]([SubResource("L1"), SubResource("L2"), SubResource("L3"), SubResource("L4"), SubResource("L5"), SubResource("L6"), SubResource("L7"), SubResource("L8"), SubResource("L9"), SubResource("L10"), SubResource("L11")])
transfer = PackedStringArray("Town", "home")
setstep = 3
party = PackedStringArray()
