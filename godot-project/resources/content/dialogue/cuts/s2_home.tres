[gd_resource type="Resource" script_class="CutsceneEntry" format=3]

[ext_resource type="Script" path="res://scripts/dialogue/cutscene_line.gd" id="1_line"]
[ext_resource type="Script" path="res://scripts/dialogue/cutscene_entry.gd" id="2_entry"]

[sub_resource type="Resource" id="L1"]
script = ExtResource("1_line")
speaker = "瑪琳"
text = "（叉腰）虧我還追出去！要不是亞倫大哥剛好路過——"

[sub_resource type="Resource" id="L2"]
script = ExtResource("1_line")
speaker = "路德"
text = "我知道啦……我只是想證明我可以。"

[sub_resource type="Resource" id="L3"]
script = ExtResource("1_line")
speaker = "漢克"
text = "（抱著手臂靠在門邊）證明了什麼？"

[sub_resource type="Resource" id="L4"]
script = ExtResource("1_line")
speaker = "路德"
text = "（抬頭）我會變強。下次——"

[sub_resource type="Resource" id="L5"]
script = ExtResource("1_line")
speaker = "漢克"
text = "冒險不是輸了再來一場的遊戲。有些人，沒有下次。"

[sub_resource type="Resource" id="L6"]
script = ExtResource("1_line")
speaker = ""
text = "（房間安靜下來。瑪莎手上的藥布，停了一下。）"

[sub_resource type="Resource" id="L7"]
script = ExtResource("1_line")
speaker = "路德"
text = "可你們當年不也——"

[sub_resource type="Resource" id="L8"]
script = ExtResource("1_line")
speaker = "漢克"
text = "所以我才知道。我和你媽在外面走了那麼多年，沒成為什麼英雄，只學會哪些墓碑原本不該立在那裡。（轉身離開）……別把我們走過的路，想得太漂亮。"

[sub_resource type="Resource" id="L9"]
script = ExtResource("1_line")
speaker = "瑪莎"
text = "（替他敷上藥草，輕聲）你爸說得難聽，是因為他記得的事，比你知道的多。先別急著怪他。"

[sub_resource type="Resource" id="L10"]
script = ExtResource("1_line")
speaker = ""
text = "（去和家人、鎮上的人說說話吧——他們嘴上唸著，手上卻一個個幫你打點行裝。）"

[resource]
script = ExtResource("2_entry")
id = "s2_home"
once = "c_s2_home"
lines = Array[ExtResource("1_line")]([SubResource("L1"), SubResource("L2"), SubResource("L3"), SubResource("L4"), SubResource("L5"), SubResource("L6"), SubResource("L7"), SubResource("L8"), SubResource("L9"), SubResource("L10")])
transfer = PackedStringArray()
setstep = 4
party = PackedStringArray()
