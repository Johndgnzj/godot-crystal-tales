[gd_resource type="Resource" script_class="CutsceneEntry" format=3]

[ext_resource type="Script" path="res://scripts/dialogue/cutscene_line.gd" id="1_line"]
[ext_resource type="Script" path="res://scripts/dialogue/cutscene_entry.gd" id="2_entry"]

[sub_resource type="Resource" id="L1"]
script = ExtResource("1_line")
speaker = "瑪琳"
text = "（推門進來）你總算沒鎖門。"

[sub_resource type="Resource" id="L2"]
script = ExtResource("1_line")
speaker = "路德"
text = "……鎖壞了。"

[sub_resource type="Resource" id="L3"]
script = ExtResource("1_line")
speaker = "瑪琳"
text = "那也算進步。（在床沿坐下）你打算在這裡等多久？等亞倫大哥自己回來，還是等總部替你找到答案？"

[sub_resource type="Resource" id="L4"]
script = ExtResource("1_line")
speaker = "路德"
text = "……是我害他留在那裡。"

[sub_resource type="Resource" id="L5"]
script = ExtResource("1_line")
speaker = "瑪琳"
text = "你跟去，是錯的。（直視他）可是叫你回來，是亞倫大哥自己決定的。你一直說「都是我害的」——那他拚了命讓你帶回來的消息呢？也要一起丟掉嗎？"

[sub_resource type="Resource" id="L6"]
script = ExtResource("1_line")
speaker = "路德"
text = "（握緊膝上的手，抬起頭）……瑪琳，我決定了。我要成為真正的冒險者。不是為了讓別人覺得我厲害——我得查清楚礦山裡發生了什麼，把亞倫大哥找回來。"

[sub_resource type="Resource" id="L7"]
script = ExtResource("1_line")
speaker = "瑪琳"
text = "（把行囊踢到他腳邊，忽然笑了）要去就一起去。你一個人，我不放心。"

[sub_resource type="Resource" id="L8"]
script = ExtResource("1_line")
speaker = ""
text = "（瑪琳加入了隊伍！去公會找緹娜登錄，成為正式的冒險者吧。）"

[resource]
script = ExtResource("2_entry")
id = "s4_join"
once = "c_s4_join"
lines = Array[ExtResource("1_line")]([SubResource("L1"), SubResource("L2"), SubResource("L3"), SubResource("L4"), SubResource("L5"), SubResource("L6"), SubResource("L7"), SubResource("L8")])
transfer = PackedStringArray()
setstep = 9
party = PackedStringArray("ludo", "marin")
