[gd_resource type="Resource" script_class="NpcDialogue" format=3]

[ext_resource type="Script" path="res://scripts/dialogue/dialogue_entry.gd" id="1_leeos"]
[ext_resource type="Script" path="res://scripts/dialogue/npc_dialogue.gd" id="2_t21pt"]

[sub_resource type="Resource" id="Resource_6seby"]
script = ExtResource("1_leeos")
speaker = "朵拉"
lines = PackedStringArray("累了吧？床鋪都幫你們鋪好了。", "（隊伍完全恢復了！）")
action = "heal"
cmd = "rest"
label = "住宿"

[sub_resource type="Resource" id="Resource_8477t"]
script = ExtResource("1_leeos")
when = "ch1_step==0"
speaker = "朵拉"
lines = PackedStringArray("要跟亞倫先生出門？路上小心。", "回來我煮好吃的等你們。")
cmd = "talk"

[sub_resource type="Resource" id="Resource_ltfa2"]
script = ExtResource("1_leeos")
speaker = "朵拉"
lines = PackedStringArray("瑪琳那孩子，就拜託你多照應了。", "想歇歇隨時說一聲，自己家不收錢的。")
cmd = "talk"

[sub_resource type="Resource" id="rumor"]
script = ExtResource("1_leeos")
when = "reg==1"
speaker = "朵拉"
lines = PackedStringArray("礦山的傳聞啊……我旅店住過一個從礦區逃出來的老礦工，說夜裡聽見礦坑深處有『敲石頭的聲音』，明明裡頭早就沒人了。", "他嚇得連夜就走，房錢還多付了呢。")
action = "rumor_dora"
cmd = "rumor_dora"
label = "打聽礦山"
done = "rumor_dora"

[resource]
script = ExtResource("2_t21pt")
id = "dora"
entries = Array[ExtResource("1_leeos")]([SubResource("Resource_6seby"), SubResource("Resource_8477t"), SubResource("Resource_ltfa2"), SubResource("rumor")])
